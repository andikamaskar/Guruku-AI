# Django Secret Key
SECRET_KEY=django-insecure-your-secret-key-here

# Debug mode (True for development, False for production)
DEBUG=True

# Hosts allowed to access Django. Separate multiple hosts with commas.
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (PostgreSQL)
DB_NAME=guruku_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Google Gemini AI API Key
# Dapatkan dari: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Chatbot protection and context limits
CHATBOT_MAX_MESSAGE_LENGTH=4000
CHATBOT_RATE_LIMIT_COUNT=20
CHATBOT_RATE_LIMIT_WINDOW=300
CHATBOT_HISTORY_LIMIT=20
CHATBOT_MAX_CONTEXT_MESSAGES=40
GEMINI_REQUEST_TIMEOUT=30
