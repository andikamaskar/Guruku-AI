# Base URL untuk Backend API Guruku.AI
# Contoh untuk Emulator Android:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api

# Contoh untuk Web / iOS Simulator:
# EXPO_PUBLIC_API_URL=http://localhost:8000/api

# Contoh untuk HP Fisik (ganti dengan IP LAN komputer Anda atau URL tunnel ngrok):
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api
