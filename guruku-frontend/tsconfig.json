{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".", // Set baseUrl untuk proyek
    "paths": {
      "@/*": [
        "./*"
      ] // Alias untuk mempermudah import dari src/
      //"@/*": ["src/*"]                       // Alias untuk mempermudah import dari src/
    }
  },
  "include": [
    "src/**/*",
    "app/**/*",
    "config/**/*",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}